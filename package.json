{
  "name": "shengqian-podcast-search",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "demo:prepare": "python3 -m backend.pipelines.export_demo_playlist",
    "typecheck": "tsc --noEmit",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "corpus:serve": ".venv/bin/python -m backend.playlist_service",
    "build": "node scripts/check-deployment.mjs && next build --webpack",
    "start": "next start",
    "test": "npm run test:python && npm run test:web",
    "test:needs": "node --experimental-strip-types --test tests/needs.test.mjs",
    "needs:evaluate": "node --experimental-strip-types scripts/evaluate_needs.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:web": "node --experimental-strip-types --test tests/player.test.mjs tests/needs.test.mjs tests/corpus-bridge.test.mjs tests/retrieval.test.mjs",
    "test:python": ".venv/bin/python -m unittest discover -s tests -p 'test_*.py'",
    "snapshot:export": ".venv/bin/python -m backend.pipelines.export_web_snapshot",
    "snapshot:verify": "node scripts/check-deployment.mjs",
    "test:production": "node --test tests/rendered-html.test.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "next": "16.3.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
